<!---------------  Accordance Design start here---------------->




.accord-table{
  display: flex;
  flex-direction: column;
  margin:0px;
  padding: 100px 20px;
  width:100%;
  background:white;
  box-shadow:#93929137 7px 7px 30px;
}

.accord-table h2{
  font-size:1rem;
  margin-bottom:30px;
  text-align: center;
  background: var(--orange-gradient);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.faq-container {
  width: 95%;
  margin: 0 auto;
  text-align: left;
}

.question-tab{
  display:flex;
  padding:10px 20px;
  gap:20px;
  position:relative;
  transition: all 0.7s ease-in-out;
}

.question-tab h4{
  font-size:1rem;
  color:rgb(255, 255, 255);
  font-weight:600;
  background: var(--orange-gradient);
  padding:5px 10px;
  position:absolute;
  right:10px;
  border-radius:50px;
  box-shadow:#91929365 0px 0px 5px;
  cursor: pointer;
  transition: all 0.7s ease-in-out;
}

.question-tab:hover h4{
  background: white;
  color:var(--orange-color);
  right:20px;
}

.accordion {
  color: rgb(139, 137, 137);
  cursor: pointer;
  padding: 15px;
  width: 100%;
  border: none;
  text-align: left;
  outline: none;
  font-size: 18px;
  transition: background 0.3s ease, padding 0.3s ease;
  border-radius: 5px;
  box-shadow:#91929365 0px 0px 5px;
}

.accordion:hover {
  background: var(--orange-gradient);
  color:white;
  padding-left: 20px; /* Smooth animation */
}

.panel {
  display:none;
  cursor: pointer;
  padding: 15px 30px;
  background: transparent;
  overflow-x: hidden;
  border-radius: 5px;
  margin-bottom: 10px;
   box-shadow:#62420c6e 0px 0px 5px;
  transition: all 0.3s ease-in-out;
     /*for gradient text colour*/
     background:var(--orange-gradient);
     -webkit-background-clip: text;
     -webkit-text-fill-color: transparent;
        /*for gradient text colour*/
}