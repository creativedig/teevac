CSS DESIGN OF WHY FROM HERE--------------------------

.why-virtual{
  background:var( --gray-color);
  padding:150px 30px;
  text-align:center;
}

.why-virtual h2{
  font-size:1.5rem;
  font-family: "Raleway", serif;
  font-optical-sizing: auto; 
  font-weight: 700;
      /*for gradient text colour*/
      background:var(--dark-gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
          /*for gradient text colour*/
}

.why-virtual p{
  font-size:.7rem;
  font-family: "Libre Franklin", serif;
  font-weight: 400;
  line-height:20px;
  color:rgb(106, 105, 105);
  margin-bottom:30px;
}

.why-virtual-box{
  display:flex;
  flex-wrap:wrap;
  justify-content: space-around;
  align-items: center;
  margin-top:0px 20px;
  padding:0px 20px;
}

.inner-box-img{
  width:50%;
  height:auto;
  overflow:hidden;
  border-radius:10px;
}

.why-virtual-box img{
  width:100%;
}

.inner-virtual-box{
  display:flex;
  flex-direction:column;
  width:100%;
  padding:60px 35px;
  align-items:center;
  border-radius:20px;
  box-shadow: 0 0 30px rgba(0, 0, 0, 0.1);
  background:white;
  margin:10px 0px;
  transition: all 0.5s ease-in-out;
  cursor:pointer;
}

.inner-virtual-box:hover{
  transform: scale(1.05);
  border:1px solid var(--dark-blue);
  background:var(--light-blue-gradient);
}

.inner-virtual-box:nth-child(2){
  background:var(--light-blue-gradient);
}

.inner-virtual-box:nth-child(2):hover{
  background:white;
  transform:translateX(20px);
}

.inner-virtual-box h4{
  font-size:1.2rem;
  font-optical-sizing: auto;
  font-weight: 600;
    /*for gradient text colour*/
    background:var(--dark-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
        /*for gradient text colour*/
   margin:10px 0px;
   text-transform:uppercase;
}

.inner-virtual-box p{
  font-size:.9rem;
  font-weight: 400;
  line-height:20px;
  color:var(--light-orange-color);
}

